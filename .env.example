# Gapwatch environment variables
# Copy to .env.local and fill in. This file is the documented reference for
# every variable the app reads. Keep it in sync when you add one.

# --- Login accounts --------------------------------------------------------
# Two fixed accounts. Viewers can see the board and trends; admins can also
# use the admin page.
VIEWER_USERNAME=
VIEWER_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign session cookies. Any long random string.
SESSION_SECRET=

# --- TfL Unified API -------------------------------------------------------
# Comma-separated transport modes to poll. Valid values include:
# tube, dlr, overground, elizabeth-line, tram, bus, river-bus, cable-car
# Defaults to the value below when unset.
TFL_MODES=

# Optional app key from https://api-portal.tfl.gov.uk (free registration).
# Without one, requests are anonymous and more tightly rate-limited.
TFL_APP_KEY=
